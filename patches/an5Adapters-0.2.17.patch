index 0000000..3a80a8c
--- /dev/null
+++ b/dotnet/Vector/VectorProviders.cs
@@ -0,0 +1,321 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net.Http;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace An5Adapters.Vector
+{
+    public enum VectorProviderKind
+    {
+        NBase,
+        Qdrant,
+        Chroma,
+        Pinecone,
+        Weaviate,
+        Milvus
+    }
+
+    public sealed class VectorRecord
+    {
+        public string Id { get; set; } = string.Empty;
+        public List<double> Vector { get; set; } = new();
+        public Dictionary<string, object?>? Metadata { get; set; }
+    }
+
+    public sealed class VectorSearchHit
+    {
+        public string Id { get; set; } = string.Empty;
+        public double Distance { get; set; }
+        public Dictionary<string, object?>? Metadata { get; set; }
+    }
+
+    public interface IVectorStoreProvider
+    {
+        VectorProviderKind Provider { get; }
+        string Endpoint { get; }
+        Task<bool> HealthAsync(CancellationToken ct = default);
+        Task<int> UpsertAsync(IEnumerable<VectorRecord> vectors, string? collection = null, CancellationToken ct = default);
+        Task<List<VectorSearchHit>> SearchAsync(IEnumerable<double> vector, int k = 10, string distanceMetric = "cosine", string? collection = null, CancellationToken ct = default);
+        Task<int> DeleteAsync(IEnumerable<string> ids, string? collection = null, CancellationToken ct = default);
+    }
+
+    public sealed class HttpVectorStoreClient : IVectorStoreProvider
+    {
+        private static readonly HttpClient SharedHttp = new() { Timeout = TimeSpan.FromSeconds(30) };
+
+        public VectorProviderKind Provider { get; }
+        public string Endpoint { get; }
+        public string Collection { get; }
+        public string? Namespace { get; }
+        public string Tenant { get; }
+        public string Database { get; }
+        public string? DbName { get; }
+        private readonly string? _token;
+        private readonly HttpClient _http;
+        private readonly Dictionary<string, string> _chromaIds = new();
+
+        public HttpVectorStoreClient(
+            VectorProviderKind provider,
+            string endpoint,
+            string collection = "an5",
+            string? ns = null,
+            string tenant = "default_tenant",
+            string database = "default_database",
+            string? dbName = null,
+            string? token = null,
+            HttpClient? httpClient = null)
+        {
+            Provider = provider;
+            Endpoint = endpoint.TrimEnd('/');
+            Collection = collection;
+            Namespace = ns;
+            Tenant = tenant;
+            Database = database;
+            DbName = dbName;
+            _token = token;
+            _http = httpClient ?? SharedHttp;
+        }
+
+        public static VectorProviderKind? DetectProvider(string? connStr)
+        {
+            if (string.IsNullOrWhiteSpace(connStr)) return null;
+            var lower = connStr.Trim().ToLowerInvariant();
+            if (lower.StartsWith("nbase:")) return VectorProviderKind.NBase;
+            if (lower.StartsWith("qdrant:")) return VectorProviderKind.Qdrant;
+            if (lower.StartsWith("chroma:")) return VectorProviderKind.Chroma;
+            if (lower.StartsWith("pinecone:")) return VectorProviderKind.Pinecone;
+            if (lower.StartsWith("weaviate:")) return VectorProviderKind.Weaviate;
+            if (lower.StartsWith("milvus:")) return VectorProviderKind.Milvus;
+            return null;
+        }
+
+        public static bool IsVectorConnectionString(string? connStr) => DetectProvider(connStr) != null;
+
+        public static HttpVectorStoreClient FromConnectionString(string connStr, HttpClient? httpClient = null)
+        {
+            var kind = DetectProvider(connStr) ?? throw new ArgumentException($"Unsupported vector connection string: {connStr}");
+            var raw = connStr.Trim();
+            var idx = raw.IndexOf(':');
+            var rest = raw[(idx + 1)..];
+            if (rest.StartsWith("//")) rest = rest[2..];
+
+            var qIdx = rest.IndexOf('?');
+            var pathPart = qIdx >= 0 ? rest[..qIdx] : rest;
+            var queryPart = qIdx >= 0 ? rest[(qIdx + 1)..] : string.Empty;
+            var query = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            foreach (var pair in queryPart.Split('&', StringSplitOptions.RemoveEmptyEntries))
+            {
+                var eq = pair.IndexOf('=');
+                if (eq > 0) query[Uri.UnescapeDataString(pair[..eq])] = Uri.UnescapeDataString(pair[(eq + 1)..]);
+            }
+
+            var host = pathPart.Trim().TrimEnd('/');
+            string? pathParam = null;
+            if (!string.IsNullOrEmpty(host) && !host.Contains("://"))
+            {
+                var slash = host.IndexOf('/');
+                if (slash >= 0)
+                {
+                    pathParam = host[(slash + 1)..];
+                    host = host[..slash];
+                }
+            }
+
+            var scheme = kind == VectorProviderKind.Pinecone ? "https" : "http";
+            var fallback = kind switch
+            {
+                VectorProviderKind.NBase => "localhost:1307",
+                VectorProviderKind.Qdrant => "localhost:6333",
+                VectorProviderKind.Chroma => "localhost:8000",
+                VectorProviderKind.Pinecone => "localhost",
+                VectorProviderKind.Weaviate => "localhost:8080",
+                VectorProviderKind.Milvus => "localhost:19530",
+                _ => "localhost"
+            };
+            var url = string.IsNullOrEmpty(host) ? $"{scheme}://{fallback}" : (host.Contains("://") ? host : $"{scheme}://{host}");
+            var col = query.GetValueOrDefault("collection") ?? query.GetValueOrDefault("className") ?? pathParam ?? (kind == VectorProviderKind.Weaviate ? "An5Vector" : "an5");
+            var ns = query.GetValueOrDefault("namespace") ?? (kind == VectorProviderKind.Pinecone ? pathParam : null);
+            var token = query.GetValueOrDefault("apiKey") ?? query.GetValueOrDefault("token");
+
+            return new HttpVectorStoreClient(
+                kind,
+                url,
+                col,
+                ns,
+                query.GetValueOrDefault("tenant") ?? "default_tenant",
+                query.GetValueOrDefault("database") ?? "default_database",
+                query.GetValueOrDefault("dbName"),
+                token,
+                httpClient);
+        }
+
+        private async Task<JsonDocument> SendJsonAsync(HttpMethod method, string path, object? payload, CancellationToken ct)
+        {
+            using var req = new HttpRequestMessage(method, Endpoint + path);
+            if (!string.IsNullOrEmpty(_token))
+            {
+                if (Provider is VectorProviderKind.Qdrant or VectorProviderKind.Pinecone)
+                    req.Headers.TryAddWithoutValidation("api-key", _token);
+                else
+                    req.Headers.TryAddWithoutValidation("Authorization", $"Bearer {_token}");
+            }
+            if (payload != null)
+            {
+                req.Content = new StringContent(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");
+            }
+            using var resp = await _http.SendAsync(req, ct);
+            var text = await resp.Content.ReadAsStringAsync(ct);
+            resp.EnsureSuccessStatusCode();
+            return string.IsNullOrWhiteSpace(text) ? JsonDocument.Parse("{}") : JsonDocument.Parse(text);
+        }
+
+        public async Task<bool> HealthAsync(CancellationToken ct = default)
+        {
+            try
+            {
+                switch (Provider)
+                {
+                    case VectorProviderKind.NBase: await SendJsonAsync(HttpMethod.Get, "/health", null, ct); break;
+                    case VectorProviderKind.Qdrant: await SendJsonAsync(HttpMethod.Get, "/healthz", null, ct); break;
+                    case VectorProviderKind.Chroma: await SendJsonAsync(HttpMethod.Get, "/api/v2/heartbeat", null, ct); break;
+                    case VectorProviderKind.Pinecone: await SendJsonAsync(HttpMethod.Post, "/describe_index_stats", new { }, ct); break;
+                    case VectorProviderKind.Weaviate: await SendJsonAsync(HttpMethod.Get, "/v1/.well-known/ready", null, ct); break;
+                    case VectorProviderKind.Milvus: await SendJsonAsync(HttpMethod.Post, "/v2/vectordb/collections/list", new { }, ct); break;
+                }
+                return true;
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        public async Task<int> UpsertAsync(IEnumerable<VectorRecord> vectors, string? collection = null, CancellationToken ct = default)
+        {
+            var list = vectors.ToList();
+            if (list.Count == 0) return 0;
+            var col = collection ?? Collection;
+            switch (Provider)
+            {
+                case VectorProviderKind.NBase:
+                    await SendJsonAsync(HttpMethod.Post, "/api/vectors", list.Select(v => new { id = v.Id, vector = v.Vector, metadata = v.Metadata }), ct);
+                    break;
+                case VectorProviderKind.Qdrant:
+                    await SendJsonAsync(HttpMethod.Put, $"/collections/{Uri.EscapeDataString(col)}/points?wait=true", new { points = list.Select(v => new { id = v.Id, vector = v.Vector, payload = v.Metadata }) }, ct);
+                    break;
+                case VectorProviderKind.Chroma:
+                    var cid = await ResolveChromaIdAsync(col, ct);
+                    await SendJsonAsync(HttpMethod.Post, $"{ChromaBase()}/{Uri.EscapeDataString(cid)}/upsert", new { ids = list.Select(v => v.Id), embeddings = list.Select(v => v.Vector), metadatas = list.Select(v => v.Metadata ?? new()) }, ct);
+                    break;
+                case VectorProviderKind.Pinecone:
+                    await SendJsonAsync(HttpMethod.Post, "/vectors/upsert", new { vectors = list.Select(v => new { id = v.Id, values = v.Vector, metadata = v.Metadata }), @namespace = Namespace }, ct);
+                    break;
+                case VectorProviderKind.Weaviate:
+                    await SendJsonAsync(HttpMethod.Post, "/v1/batch/objects", new { objects = list.Select(v => new { @class = col, id = v.Id, vector = v.Vector, properties = v.Metadata ?? new() }) }, ct);
+                    break;
+                case VectorProviderKind.Milvus:
+                    await SendJsonAsync(HttpMethod.Post, "/v2/vectordb/entities/upsert", new { collectionName = col, dbName = DbName, data = list.Select(v => new { id = v.Id, vector = v.Vector }) }, ct);
+                    break;
+            }
+            return list.Count;
+        }
+
+        public async Task<List<VectorSearchHit>> SearchAsync(IEnumerable<double> vector, int k = 10, string distanceMetric = "cosine", string? collection = null, CancellationToken ct = default)
+        {
+            var vec = vector.ToList();
+            var col = collection ?? Collection;
+            var hits = new List<VectorSearchHit>();
+            switch (Provider)
+            {
+                case VectorProviderKind.Qdrant:
+                    using (var doc = await SendJsonAsync(HttpMethod.Post, $"/collections/{Uri.EscapeDataString(col)}/points/search", new { vector = vec, limit = k, with_payload = true }, ct))
+                    {
+                        if (doc.RootElement.TryGetProperty("result", out var arr))
+                        {
+                            foreach (var el in arr.EnumerateArray())
+                            {
+                                var score = el.TryGetProperty("score", out var s) ? s.GetDouble() : 0.0;
+                                hits.Add(new VectorSearchHit { Id = el.GetProperty("id").ToString(), Distance = distanceMetric == "euclidean" ? score : (distanceMetric == "dot" ? -score : 1.0 - score) });
+                            }
+                        }
+                    }
+                    break;
+                case VectorProviderKind.Pinecone:
+                    using (var doc = await SendJsonAsync(HttpMethod.Post, "/query", new { vector = vec, topK = k, includeMetadata = true, @namespace = Namespace }, ct))
+                    {
+                        if (doc.RootElement.TryGetProperty("matches", out var arr))
+                        {
+                            foreach (var el in arr.EnumerateArray())
+                            {
+                                var score = el.TryGetProperty("score", out var s) ? s.GetDouble() : 0.0;
+                                hits.Add(new VectorSearchHit { Id = el.GetProperty("id").ToString(), Distance = distanceMetric == "euclidean" ? score : (distanceMetric == "dot" ? -score : 1.0 - score) });
+                            }
+                        }
+                    }
+                    break;
+                default:
+                    using (var doc = await SendJsonAsync(HttpMethod.Post, "/api/search", new { vector = vec, k, includeMetadata = true }, ct))
+                    {
+                        if (doc.RootElement.TryGetProperty("results", out var arr))
+                        {
+                            foreach (var el in arr.EnumerateArray())
+                            {
+                                hits.Add(new VectorSearchHit { Id = el.GetProperty("id").ToString(), Distance = el.TryGetProperty("dist", out var d) ? d.GetDouble() : 0.0 });
+                            }
+                        }
+                    }
+                    break;
+            }
+            return hits;
+        }
+
+        public async Task<int> DeleteAsync(IEnumerable<string> ids, string? collection = null, CancellationToken ct = default)
+        {
+            var list = ids.ToList();
+            if (list.Count == 0) return 0;
+            var col = collection ?? Collection;
+            switch (Provider)
+            {
+                case VectorProviderKind.Qdrant:
+                    await SendJsonAsync(HttpMethod.Post, $"/collections/{Uri.EscapeDataString(col)}/points/delete?wait=true", new { points = list }, ct);
+                    break;
+                case VectorProviderKind.Pinecone:
+                    await SendJsonAsync(HttpMethod.Post, "/vectors/delete", new { ids = list, @namespace = Namespace }, ct);
+                    break;
+                default:
+                    foreach (var id in list)
+                    {
+                        await SendJsonAsync(HttpMethod.Delete, $"/api/vectors/{Uri.EscapeDataString(id)}", null, ct);
+                    }
+                    break;
+            }
+            return list.Count;
+        }
+
+        private string ChromaBase() => $"/api/v2/tenants/{Uri.EscapeDataString(Tenant)}/databases/{Uri.EscapeDataString(Database)}/collections";
+
+        private async Task<string> ResolveChromaIdAsync(string name, CancellationToken ct)
+        {
+            if (_chromaIds.TryGetValue(name, out var cached)) return cached;
+            try
+            {
+                using var doc = await SendJsonAsync(HttpMethod.Get, $"{ChromaBase()}/{Uri.EscapeDataString(name)}", null, ct);
+                if (doc.RootElement.TryGetProperty("id", out var idEl))
+                {
+                    var id = idEl.GetString() ?? name;
+                    _chromaIds[name] = id;
+                    return id;
+                }
+            }
+            catch { }
+            using var created = await SendJsonAsync(HttpMethod.Post, ChromaBase(), new { name, get_or_create = true }, ct);
+            var cid = created.RootElement.TryGetProperty("id", out var cidEl) ? (cidEl.GetString() ?? name) : name;
+            _chromaIds[name] = cid;
+            return cid;
+        }
+    }
+}
diff --git a/golang/an5_adapter.go b/golang/an5_adapter.go
index 9fbf690..79b95fb 100644
--- a/golang/an5_adapter.go
+++ b/golang/an5_adapter.go
@@ -12,6 +12,7 @@ import (
 	"an5adapters/mssql"
 	"an5adapters/postgres"
 	"an5adapters/sqlite"
+	"an5adapters/vector"
 )
 
 // Re-export core base types and functions for package root convenience.
@@ -71,23 +72,70 @@ type An5Adapter struct {
 	// VectorSupport carries the SQLite vector settings. Set it before the first
 	// search to load sqlite-vec or to pin a strategy.
 	VectorSupport sqlite.VectorSupport
+	// VectorStore holds an optional external vector database provider (Qdrant,
+	// Chroma, Pinecone, Weaviate, Milvus, or NBase).
+	VectorStore     vector.VectorStoreProvider
+	VectorStoreOnly bool
 }
 
 // NewAn5Adapter constructs an An5Adapter instance.
 func NewAn5Adapter(db *sql.DB, connStr string) *An5Adapter {
+	if vector.IsVectorConnectionString(connStr) {
+		store, err := vector.CreateVectorStore(connStr)
+		if err == nil {
+			return &An5Adapter{
+				Dialect:         base.DialectSqlite,
+				VectorStore:     store,
+				VectorStoreOnly: true,
+			}
+		}
+	}
 	return &An5Adapter{
 		DB:      db,
 		Dialect: base.DetectDialect(connStr),
 	}
 }
 
+// NewVectorAn5Adapter constructs a vector-only An5Adapter from a vector DB connection string.
+func NewVectorAn5Adapter(connStr string) (*An5Adapter, error) {
+	store, err := vector.CreateVectorStore(connStr)
+	if err != nil {
+		return nil, err
+	}
+	return &An5Adapter{
+		Dialect:         base.DialectSqlite,
+		VectorStore:     store,
+		VectorStoreOnly: true,
+	}, nil
+}
+
+// SetVectorStore attaches an external vector database provider to the adapter.
+func (a *An5Adapter) SetVectorStore(store vector.VectorStoreProvider) {
+	a.VectorStore = store
+}
+
+// VectorHealth checks the health of the attached external vector store.
+func (a *An5Adapter) VectorHealth(ctx context.Context) (map[string]interface{}, error) {
+	if a.VectorStore == nil {
+		return map[string]interface{}{"ok": false, "error": "no vector store configured"}, nil
+	}
+	return a.VectorStore.Health(ctx)
+}
+
 // Connect validates the database connection (ping).
 func (a *An5Adapter) Connect(ctx context.Context) error {
+	if a.VectorStoreOnly && a.VectorStore != nil {
+		_, err := a.VectorStore.Health(ctx)
+		return err
+	}
 	return a.DB.PingContext(ctx)
 }
 
 // Disconnect closes the underlying database connection pool.
 func (a *An5Adapter) Disconnect() error {
+	if a.DB == nil {
+		return nil
+	}
 	return a.DB.Close()
 }
 
diff --git a/golang/vector/vector.go b/golang/vector/vector.go
new file mode 100644
index 0000000..962592c
--- /dev/null
+++ b/golang/vector/vector.go
@@ -0,0 +1,1096 @@
+// Package vector provides unified REST clients for external vector databases
+// (NBase, Qdrant, Chroma, Pinecone, Weaviate, and Milvus) using Go's standard library.
+package vector
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// VectorProviderError is returned when a vector database HTTP call fails.
+type VectorProviderError struct {
+	Provider string
+	Status   int
+	Message  string
+}
+
+func (e *VectorProviderError) Error() string {
+	return fmt.Sprintf("%s: %s", e.Provider, e.Message)
+}
+
+// VectorRecord represents a vector point to upsert.
+type VectorRecord struct {
+	ID       string                 `json:"id"`
+	Vector   []float64              `json:"vector"`
+	Metadata map[string]interface{} `json:"metadata,omitempty"`
+}
+
+// SearchOptions configures a vector similarity search.
+type SearchOptions struct {
+	K               int
+	DistanceMetric  string
+	Filter          map[string]interface{}
+	IncludeMetadata *bool
+	IncludeVectors  bool
+	Collection      string
+	Namespace       string
+}
+
+// VectorSearchHit represents a single search result from a vector store.
+type VectorSearchHit struct {
+	ID       string                 `json:"id"`
+	Distance float64                `json:"distance"`
+	Metadata map[string]interface{} `json:"metadata,omitempty"`
+	Vector   []float64              `json:"vector,omitempty"`
+}
+
+// UpsertOptions configures an Upsert call.
+type UpsertOptions struct {
+	Collection string
+	Namespace  string
+}
+
+// DeleteOptions configures a Delete call.
+type DeleteOptions struct {
+	Collection string
+	Namespace  string
+}
+
+// VectorStoreProvider is the unified interface implemented by all vector DB clients.
+type VectorStoreProvider interface {
+	Provider() string
+	Endpoint() string
+	IDField() string
+	ModelField() string
+	Health(ctx context.Context) (map[string]interface{}, error)
+	Upsert(ctx context.Context, vectors []VectorRecord, opts *UpsertOptions) (int, error)
+	Search(ctx context.Context, vector []float64, opts *SearchOptions) ([]VectorSearchHit, error)
+	Delete(ctx context.Context, ids []string, opts *DeleteOptions) (int, error)
+}
+
+// HTTPDoer abstracts *http.Client for offline testing.
+type HTTPDoer interface {
+	Do(req *http.Request) (*http.Response, error)
+}
+
+// DetectVectorProvider returns the vector provider name for a connection string, or "".
+func DetectVectorProvider(connStr string) string {
+	lower := strings.ToLower(strings.TrimSpace(connStr))
+	for _, p := range []string{"nbase", "qdrant", "chroma", "pinecone", "weaviate", "milvus"} {
+		if strings.HasPrefix(lower, p+":") {
+			return p
+		}
+	}
+	return ""
+}
+
+// IsVectorConnectionString reports whether connStr targets an external vector database.
+func IsVectorConnectionString(connStr string) bool {
+	return DetectVectorProvider(connStr) != ""
+}
+
+type parsedConn struct {
+	URL          string
+	PathParam    string
+	APIKey       string
+	Token        string
+	Tenant       string
+	Database     string
+	CollectionID string
+	DBName       string
+	IDField      string
+	ModelField   string
+	Method       string
+	Timeout      time.Duration
+	Query        url.Values
+}
+
+func parseVectorConn(provider, connStr, defaultScheme, fallbackHost string) (*parsedConn, error) {
+	raw := strings.TrimSpace(connStr)
+	lower := strings.ToLower(raw)
+	prefix := provider + ":"
+	if !strings.HasPrefix(lower, prefix) {
+		return nil, fmt.Errorf("not a %s connection string: %s", provider, raw)
+	}
+	rest := raw[len(prefix):]
+	if strings.HasPrefix(rest, "//") {
+		rest = rest[2:]
+	}
+	pathPart := rest
+	queryPart := ""
+	if idx := strings.IndexByte(rest, '?'); idx != -1 {
+		pathPart = rest[:idx]
+		queryPart = rest[idx+1:]
+	}
+	q, _ := url.ParseQuery(queryPart)
+	trimmed := strings.TrimRight(strings.TrimSpace(pathPart), "/")
+	var tail string
+	if trimmed != "" && !strings.Contains(trimmed, "://") {
+		if slash := strings.IndexByte(trimmed, '/'); slash != -1 {
+			tail = trimmed[slash+1:]
+			trimmed = trimmed[:slash]
+		}
+	}
+	var baseURL string
+	if trimmed == "" {
+		baseURL = defaultScheme + "://" + fallbackHost
+	} else if strings.Contains(trimmed, "://") {
+		baseURL = trimmed
+	} else {
+		baseURL = defaultScheme + "://" + trimmed
+	}
+	timeout := 30 * time.Second
+	if msStr := q.Get("timeoutMs"); msStr != "" {
+		if ms, err := strconv.Atoi(msStr); err == nil && ms > 0 {
+			timeout = time.Duration(ms) * time.Millisecond
+		}
+	}
+	idField := q.Get("idField")
+	if idField == "" {
+		idField = "an5Id"
+	}
+	modelField := q.Get("modelField")
+	if modelField == "" {
+		modelField = "an5Model"
+	}
+	return &parsedConn{
+		URL:          baseURL,
+		PathParam:    tail,
+		APIKey:       q.Get("apiKey"),
+		Token:        q.Get("token"),
+		Tenant:       q.Get("tenant"),
+		Database:     q.Get("database"),
+		CollectionID: q.Get("collectionId"),
+		DBName:       q.Get("dbName"),
+		IDField:      idField,
+		ModelField:   modelField,
+		Method:       q.Get("method"),
+		Timeout:      timeout,
+		Query:        q,
+	}, nil
+}
+
+func doJSON(ctx context.Context, doer HTTPDoer, timeout time.Duration, provider, baseURL, method, path string, headers map[string]string, body interface{}, out interface{}) error {
+	var bodyReader io.Reader
+	if body != nil {
+		b, err := json.Marshal(body)
+		if err != nil {
+			return err
+		}
+		bodyReader = bytes.NewReader(b)
+	}
+	if doer == nil {
+		doer = &http.Client{Timeout: timeout}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, strings.TrimRight(baseURL, "/")+path, bodyReader)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	for k, v := range headers {
+		req.Header.Set(k, v)
+	}
+	resp, err := doer.Do(req)
+	if err != nil {
+		return &VectorProviderError{Provider: provider, Message: err.Error()}
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode >= 400 {
+		return &VectorProviderError{
+			Provider: provider,
+			Status:   resp.StatusCode,
+			Message:  fmt.Sprintf("HTTP %d on %s: %s", resp.StatusCode, path, string(raw)),
+		}
+	}
+	if out != nil && len(raw) > 0 {
+		if err := json.Unmarshal(raw, out); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func similarityToDistance(score float64, metric string) float64 {
+	switch metric {
+	case "euclidean":
+		return score
+	case "dot":
+		return -score
+	default:
+		return 1.0 - score
+	}
+}
+
+type baseConfig struct {
+	provider   string
+	endpoint   string
+	token      string
+	idField    string
+	modelField string
+	timeout    time.Duration
+	httpClient HTTPDoer
+}
+
+func (b *baseConfig) Provider() string   { return b.provider }
+func (b *baseConfig) Endpoint() string   { return b.endpoint }
+func (b *baseConfig) IDField() string    { return b.idField }
+func (b *baseConfig) ModelField() string { return b.modelField }
+
+// ─── NBase ───────────────────────────────────────────────────────────────────
+
+type NBaseClient struct {
+	baseConfig
+	Method string
+}
+
+func NewNBaseClient(endpoint, token string, httpClient HTTPDoer) *NBaseClient {
+	return &NBaseClient{
+		baseConfig: baseConfig{provider: "nbase", endpoint: strings.TrimRight(endpoint, "/"), token: token, idField: "an5Id", modelField: "an5Model", timeout: 30 * time.Second, httpClient: httpClient},
+	}
+}
+
+func (c *NBaseClient) headers() map[string]string {
+	if c.token != "" {
+		return map[string]string{"Authorization": "Bearer " + c.token}
+	}
+	return nil
+}
+
+func (c *NBaseClient) Health(ctx context.Context) (map[string]interface{}, error) {
+	var res map[string]interface{}
+	if err := doJSON(ctx, c.httpClient, c.timeout, c.provider, c.endpoint, "GET", "/health", c.headers(), nil, &res); err != nil {
+		return map[string]interface{}{"ok": false, "provider": c.provider, "error": err.Error()}, err
+	}
+	if res == nil {
+		res = map[string]interface{}{}
+	}
+	res["ok"] = res["status"] == "ok"
+	res["provider"] = c.provider
+	return res, nil
+}
+
+func (c *NBaseClient) Upsert(ctx context.Context, vectors []VectorRecord, _ *UpsertOptions) (int, error) {
+	if len(vectors) == 0 {
+		return 0, nil
+	}
+	var res struct {
+		Count int `json:"count"`
+	}
+	if err := doJSON(ctx, c.httpClient, c.timeout, c.provider, c.endpoint, "POST", "/api/vectors", c.headers(), vectors, &res); err != nil {
+		return 0, err
+	}
+	if res.Count == 0 {
+		return len(vectors), nil
+	}
+	return res.Count, nil
+}
+
+func (c *NBaseClient) Search(ctx context.Context, vector []float64, opts *SearchOptions) ([]VectorSearchHit, error) {
+	k := 10
+	metric := "cosine"
+	includeMeta := true
+	if opts != nil {
+		if opts.K > 0 {
+			k = opts.K
+		}
+		if opts.DistanceMetric == "euclidean" {
+			metric = "euclidean"
+		}
+		if opts.IncludeMetadata != nil {
+			includeMeta = *opts.IncludeMetadata
+		}
+	}
+	body := map[string]interface{}{
+		"vector":          vector,
+		"k":               k,
+		"distanceMetric":  metric,
+		"includeMetadata": includeMeta,
+	}
+	if c.Method != "" {
+		body["method"] = c.Method
+	}
+	var res struct {
+		Results []struct {
+			ID       interface{}            `json:"id"`
+			Dist     float64                `json:"dist"`
+			Metadata map[string]interface{} `json:"metadata"`
+			Vector   []float64              `json:"vector"`
+		} `json:"results"`
+	}
+	if err := doJSON(ctx, c.httpClient, c.timeout, c.provider, c.endpoint, "POST", "/api/search", c.headers(), body, &res); err != nil {
+		return nil, err
+	}
+	hits := make([]VectorSearchHit, 0, len(res.Results))
+	for _, r := range res.Results {
+		hits = append(hits, VectorSearchHit{
+			ID:       fmt.Sprint(r.ID),
+			Distance: r.Dist,
+			Metadata: r.Metadata,
+			Vector:   r.Vector,
+		})
+	}
+	return hits, nil
+}
+
+func (c *NBaseClient) Delete(ctx context.Context, ids []string, _ *DeleteOptions) (int, error) {
+	deleted := 0
+	for _, id := range ids {
+		if err := doJSON(ctx, c.httpClient, c.timeout, c.provider, c.endpoint, "DELETE", "/api/vectors/"+url.PathEscape(id), c.headers(), nil, nil); err != nil {
+			return deleted, err
+		}
+		deleted++
+	}
+	return deleted, nil
+}
+
+// ─── Qdrant ──────────────────────────────────────────────────────────────────
+
+type QdrantClient struct {
+	baseConfig
+	Collection string
+}
+
+func NewQdrantClient(endpoint, collection, apiKey string, httpClient HTTPDoer) *QdrantClient {
+	if collection == "" {
+		collection = "an5"
+	}
+	return &QdrantClient{
+		baseConfig: baseConfig{provider: "qdrant", endpoint: strings.TrimRight(endpoint, "/"), token: apiKey, idField: "an5Id", modelField: "an5Model", timeout: 30 * time.Second, httpClient: httpClient},
+		Collection: collection,
+	}
+}
+
+func (c *QdrantClient) headers() map[string]string {
+	if c.token != "" {
+		return map[string]string{"api-key": c.token}
+	}
+	return nil
+}
+
+func (c *QdrantClient) Health(ctx context.Context) (map[string]interface{}, error) {
+	var res map[string]interface{}
+	if err := doJSON(ctx, c.httpClient, c.timeout, c.provider, c.endpoint, "GET", "/healthz", c.headers(), nil, &res); err != nil {
+		return map[string]interface{}{"ok": false, "provider": c.provider, "error": err.Error()}, err
+	}
+	return map[string]interface{}{"ok": true, "provider": c.provider, "endpoint": c.endpoint}, nil
+}
+
