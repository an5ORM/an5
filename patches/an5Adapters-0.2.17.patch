+	for i, v := range vectors {
+		props := v.Metadata
+		if props == nil {
+			props = map[string]interface{}{}
+		}
+		objs[i] = map[string]interface{}{"class": cls, "id": v.ID, "vector": v.Vector, "properties": props}
