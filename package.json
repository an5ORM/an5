{
  "name": "an5-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AN5 ORM monorepo workspace — lightweight, type-safe ORM for TypeScript, Python & .NET",
  "author": "an5ORM",
  "homepage": "https://an5orm.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5.git"
  },
  "license": "MIT",
  "workspaces": [
    "an5Orm",
    "an5Client",
    "an5Adapters",
    "an5Agent",
    "an5Cli",
    "an5Cli/ui",
    "an5OrmVScode",
    "an5Schema",
    "an5Tasks"
  ],
  "scripts": {
    "build":        "npm run build --workspaces --if-present",
    "test":         "npm run test --workspaces --if-present",
    "sync":         "git submodule update --init --recursive --remote",
    "generate":     "npm run generate -w an5Orm",
    "release":      "node an5Cli/dist/index.js ws . --push",
    "dryrun":       "node an5Cli/dist/index.js ws . --dry-run",
    "ui":           "node an5Cli/dist/index.js ui ."
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
