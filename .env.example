# ─── Database (required) ────────────────────────────────────────────────────────

# Connection string — supports MSSQL, PostgreSQL, MySQL, SQLite
#   MSSQL:     sqlserver://host:port;database=db;user=u;password=p;encrypt=true;trustServerCertificate=true
#   PostgreSQL: postgres://user:pass@host:5432/db
#   MySQL:      mysql://user:pass@host:3306/db
#   SQLite:     sqlite:///path/to/file.db
DATABASE_URL=sqlserver://localhost:1433;database=mydb;user=sa;password=yourpassword;encrypt=true;trustServerCertificate=true

# ─── Logging ─────────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ─── LLM (optional, for agent features and CLI release notes) ─────────────────────

# Provider: "openai", "gemini", or "custom"
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# Custom endpoint (only if LLM_PROVIDER=custom)
# LLM_ENDPOINT=https://your-custom-endpoint/v1

# ─── Embedding (for RAG/vector search) ───────────────────────────────────────────

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small