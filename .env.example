# ─── Database (required) ────────────────────────────────────────────────────────

# Connection string — supports MSSQL, PostgreSQL, MySQL, SQLite
#   MSSQL:     sqlserver://host:port;database=db;user=u;password=p;encrypt=true;trustServerCertificate=true
#   PostgreSQL: postgres://user:pass@host:5432/db
#   MySQL:      mysql://user:pass@host:3306/db
#   SQLite:     sqlite:///path/to/file.db
DATABASE_URL=sqlserver://localhost:1433;database=mydb;user=sa;password=yourpassword;encrypt=true;trustServerCertificate=true

# ─── Logging ─────────────────────────────────────────────────────────────────────

LOG_LEVEL=info